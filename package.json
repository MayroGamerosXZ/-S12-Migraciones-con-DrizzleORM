{
  "name": "s12-migraciones-con-drizzleorm",
  "version": "1.0.0",
  "description": "API HTTP en TypeScript con PostgreSQL y migraciones versionadas usando Drizzle ORM",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "schema:v1": "tsx src/db/switch-schema.ts v1",
    "schema:v2": "tsx src/db/switch-schema.ts v2",
    "db:generate": "drizzle-kit generate",
    "db:generate:v1": "drizzle-kit generate --name=initial_products_table",
    "db:generate:v2": "drizzle-kit generate --name=evolve_products_inventory",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    " generate-doc": "tsx scripts/generate-word-doc.ts"
  },
  "keywords": [
    "typescript",
    "express",
    "drizzle-orm",
    "postgresql",
    "migrations"
  ],
  "author": "Mayro Gameros",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.8.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
